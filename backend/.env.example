# Application runtime
APP_NAME=Agentic Trading Platform API
ENVIRONMENT=production
LOG_LEVEL=INFO

# Hosted Supabase PostgreSQL session pooler. URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300

# Redis runtime URL. Compose and Kubernetes override this with their Service DNS.
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECTION_RETRIES=2

# Hosted Supabase Auth
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_AUTH_TIMEOUT_SECONDS=5

# Exact browser origins allowed to call FastAPI
CORS_ORIGINS=["https://app.example.com"]

# Strategy parser
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=REPLACE_ME

# Preview queue
PREVIEW_QUEUE_NAME=preview
PREVIEW_JOB_TTL_HOURS=24
PREVIEW_JOB_TIMEOUT_SECONDS=180
PREVIEW_JOB_MAX_RETRIES=2
PREVIEW_JOB_RETRY_INTERVALS_SECONDS=[5,30]
PREVIEW_JOB_RESULT_TTL_SECONDS=86400
PREVIEW_JOB_FAILURE_TTL_SECONDS=604800
PREVIEW_JOB_STALE_AFTER_SECONDS=300
PREVIEW_JOB_RECONCILIATION_BATCH_SIZE=100
PREVIEW_JOB_REGISTRY_SCAN_LIMIT=1000
PREVIEW_JOB_LOCK_WAIT_SECONDS=5
